---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = 'Editorial Team | overtimechecker.com';
const description = 'Meet the editorial team behind overtimechecker.com. Wage-and-hour writers and reviewers.';
---
<BaseLayout title={title} description={description}>
  <h1>Editorial Team</h1>
  <p>overtimechecker.com is written and reviewed by The Click Lab's editorial team. Every calculator formula is verified against the FLSA and state Department of Labor publications.</p>

  <h2>Editorial standards</h2>
  <ul>
    <li>Cite the authority (federal regulation, state statute, DOL opinion letter).</li>
    <li>No legal advice &mdash; informational only.</li>
    <li>No paid placements or recommended-attorney lists.</li>
  </ul>

  <h2>Corrections</h2>
  <p>Found an error? Email <a href="mailto:hey@theclicklab.agency">hey@theclicklab.agency</a>. We correct within a few business days and note the change.</p>
</BaseLayout>
