---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = 'About overtimechecker.com | Overtime Pay Calculator';
const description = 'About the team behind overtimechecker.com. Free wage-and-hour calculators and worker-rights guides reviewed by the editorial team at The Click Lab.';
---
<BaseLayout title={title} description={description}>
  <h1>About overtimechecker.com</h1>
  <p>overtimechecker.com is a free wage-and-hour resource maintained by The Click Lab. Our calculator and guides help workers understand what they're owed under federal and state overtime laws.</p>

  <h2>What we do</h2>
  <p>We translate FLSA and state labor law into plain-English calculators and guides. Every page is reviewed by our <a href="/editorial">editorial team</a>, with citations to the Department of Labor and state agency sources.</p>

  <h2>What we don't do</h2>
  <p>We don't provide legal advice. Our content is general and informational. For specific wage disputes, consult a wage-and-hour attorney or your state labor agency.</p>

  <h2>How we make money</h2>
  <p>Display advertising via Google AdSense. We don't sell reader data or accept paid placements. See our <a href="/privacy">privacy policy</a>.</p>

  <h2>Contact</h2>
  <p>Questions or corrections? See our <a href="/contact">contact page</a>.</p>
</BaseLayout>
