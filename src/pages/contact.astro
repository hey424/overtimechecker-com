---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = 'Contact | overtimechecker.com';
const description = 'Contact overtimechecker.com for questions, corrections, or feedback.';
---
<BaseLayout title={title} description={description}>
  <h1>Contact</h1>
  <p>Email <a href="mailto:hey@theclicklab.agency">hey@theclicklab.agency</a> with questions, corrections, or suggestions.</p>

  <h2>What we respond to</h2>
  <ul>
    <li>Corrections to overtime math or law citations</li>
    <li>Errors or unclear language in guides</li>
    <li>Suggestions for new content</li>
    <li>Press and partnership inquiries</li>
  </ul>

  <h2>What we don't respond to</h2>
  <p>We can't evaluate your specific wage dispute or recommend specific attorneys. For your situation, contact your state labor agency or a licensed wage-and-hour attorney.</p>
</BaseLayout>
